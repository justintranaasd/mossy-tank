---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TAGLINE } from '../consts';

const todayStr = new Date().toLocaleDateString('en-CA');
const posts = (await getCollection('blog', ({ data }) => {
  if (data.draft) return false;
  return data.pubDate.toISOString().slice(0, 10) <= todayStr;
})).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>{SITE_TAGLINE}</h1>
      <p class="lead">
        Beautiful, healthy planted aquariums — without CO2 systems, confusing jargon, or killing
        your fish. Honest, beginner-friendly guides and gear picks for low-tech tanks, bettas, and
        shrimp.
      </p>
      <p><a class="btn" href="/blog/">Start with our guides →</a></p>
    </div>
  </section>

  <div class="container">
    <h2>Latest guides</h2>
    {latest.length === 0 ? (
      <p>Guides are on the way — check back soon. 🌱</p>
    ) : (
      <ul class="card-grid">
        {latest.map((post) => (
          <ArticleCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            cluster={post.data.cluster}
          />
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
