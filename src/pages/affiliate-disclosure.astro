---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---
<BaseLayout title="Affiliate Disclosure" description="How Mossy Tank makes money and our affiliate relationships.">
  <div class="container prose post">
    <h1>Affiliate Disclosure</h1>
    <p>
      {SITE_TITLE} is reader-supported. Some of the links on this site are <strong>affiliate
      links</strong>, which means we may earn a commission if you click through and make a purchase —
      at <strong>no additional cost to you</strong>.
    </p>
    <p>
      As an Amazon Associate we earn from qualifying purchases. We also participate in affiliate
      programs with other aquarium retailers and brands.
    </p>
    <p>
      Commissions never change our recommendations. We only suggest products we believe are genuinely
      good for beginners and their tanks, and we'll always tell you when something isn't worth your
      money. Our editorial decisions are independent of any commercial relationship.
    </p>
  </div>
</BaseLayout>
