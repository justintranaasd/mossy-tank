---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
---
<BaseLayout title="Privacy Policy" description="How Mossy Tank handles your data.">
  <div class="container prose post">
    <h1>Privacy Policy</h1>
    <p><em>Last updated: 1 June 2026</em></p>
    <p>
      {SITE_TITLE} ("we", "us") respects your privacy. This policy explains what we collect and why.
    </p>
    <h2>Information we collect</h2>
    <ul>
      <li><strong>Analytics:</strong> we use privacy-respecting analytics to understand which content is useful. This may include anonymised data such as pages visited, device type, and approximate location.</li>
      <li><strong>Cookies:</strong> third-party services (e.g. advertising and affiliate networks) may set cookies. You can disable cookies in your browser settings.</li>
      <li><strong>Email:</strong> if you contact us or subscribe to a newsletter, we store the details you provide solely to respond or send updates.</li>
    </ul>
    <h2>Advertising &amp; affiliates</h2>
    <p>
      We display ads and use affiliate links. Advertising partners and affiliate networks may use
      cookies to measure performance and personalise ads. See our
      <a href="/affiliate-disclosure/">affiliate disclosure</a> for more.
    </p>
    <h2>Your rights</h2>
    <p>
      You may request access to, or deletion of, any personal data you've given us by emailing
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
    <!-- TODO (operator): if you collect emails or serve EU/UK/AU users, confirm GDPR/Privacy Act
         wording and add a cookie consent banner before monetising. -->
  </div>
</BaseLayout>
