---
import { SITE_TITLE, NAV_LINKS } from '../consts';
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <img src="/favicon.svg" width="28" height="28" alt="" class="brand-icon" />
      {SITE_TITLE}
    </a>
    <nav class="nav" aria-label="Primary">
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>
